# Mine-Guard service configuration
# Copy this file to .env and adjust as needed. Never commit the real .env
# or serviceAccountKey.json to git.

# How often (seconds) the background loop re-evaluates every node's risk.
# Keep this at 30+ on Firestore's free Spark plan to avoid exhausting the
# daily read/write quota. Lower it only if you're on a paid Blaze plan
# and actually need faster updates.
PREDICTION_INTERVAL_SECONDS=30

# Whether to run the synthetic sensor simulator alongside real hardware
# ingestion. Leave this false unless you are actively demoing without
# physical sensors connected -- this is what silently created phantom
# nodes in Firestore before this fix.
SIMULATOR_ENABLED=false

# Only used when running simulator.py standalone (python simulator.py),
# not when it's driven by app.py's background loop.
SIMULATOR_INTERVAL_SECONDS=30

# Flask port
PORT=5000
HOST=0.0.0.0
DEBUG=false

# ML Risk Model Critical Threshold override (from config.pkl: 0.20)
CRITICAL_THRESHOLD=0.20

# Google Application Credentials (path to serviceAccountKey.json)
GOOGLE_APPLICATION_CREDENTIALS=service/serviceAccountKey.json
