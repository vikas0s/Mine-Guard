# SIH26025 Python Service Configuration

PORT=5000
HOST=0.0.0.0
DEBUG=false

# Background Prediction Loop interval (seconds)
PREDICTION_INTERVAL_SECONDS=5

# Built-in sensor simulator (generate fake readings when physical sensors are offline)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=5

# ML Risk Model Critical Threshold override (from config.pkl: 0.20)
CRITICAL_THRESHOLD=0.20

# Google Application Credentials
GOOGLE_APPLICATION_CREDENTIALS=service/serviceAccountKey.json
